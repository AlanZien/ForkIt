# =============================================================================
# ForkIt - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Notion Integration (for project sync)
# Get your token from: https://www.notion.so/my-integrations
# -----------------------------------------------------------------------------
NOTION_TOKEN=your_notion_integration_token
NOTION_PROJECTS_DB_ID=your_projects_database_id
NOTION_TASKS_DB_ID=your_tasks_database_id
NOTION_BUGS_DB_ID=your_bugs_database_id

# -----------------------------------------------------------------------------
# Supabase (Database & Auth)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# -----------------------------------------------------------------------------
# Mobile App (Expo)
# Note: EXPO_PUBLIC_ prefix exposes variables to the client
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
