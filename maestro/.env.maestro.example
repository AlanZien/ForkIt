# Maestro Environment Variables
# Copy this file to .env.maestro and fill in your values

# App Bundle ID (iOS) or Package Name (Android)
# For Expo: com.yourcompany.forkit or host.exp.Exponent (dev)
APP_BUNDLE_ID=host.exp.Exponent

# Backend API URL
BASE_URL=http://localhost:8000

# Test user credentials (create a test user in your database)
TEST_USER_EMAIL=test@forkit.app
TEST_USER_PASSWORD=testpassword123
